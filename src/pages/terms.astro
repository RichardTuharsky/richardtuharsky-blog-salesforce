---
import RootLayout from "@/layouts/RootLayout.astro";
import { SITE_METADATA } from "@/consts";
---

<RootLayout
  title={`Terms — ${SITE_METADATA.name}`}
  description="Terms of use for this site."
>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 xl:px-8 pt-16 pb-24">
    <p class="schema-annotation">§ — Terms</p>
    <h1 class="mt-6 font-display text-4xl sm:text-5xl leading-tight tracking-tight text-foreground">
      Terms
    </h1>

    <div class="mt-10 prose prose-neutral dark:prose-invert max-w-none">
      <h2>Content on this site</h2>
      <p>
        Notes and other written material on <a href={SITE_METADATA.siteUrl}>{SITE_METADATA.domain}</a> are © {new Date().getFullYear()} {`{{NAME}}`}. You are free to quote passages with attribution and a link back. Do not republish full articles without written permission.
      </p>

      <h2>Engagements</h2>
      <p>
        Consulting engagements are governed by a separate written agreement signed with the client. Nothing on this site constitutes a contract or a fixed price commitment — the site describes the shape of the offers; the price and scope are confirmed after the intro call.
      </p>

      <h2>Warranty</h2>
      <p>
        This site is provided as-is. I make no warranty that any specific advice on this site fits your organisation.
      </p>

      <h2>Governing law</h2>
      <p>
        {`{{GOVERNING_LAW}}`}.
      </p>

      <p class="text-sm text-muted-foreground">
        Last updated: <time datetime="{{LAST_UPDATED}}">{`{{LAST_UPDATED}}`}</time>
      </p>
    </div>
  </section>
</RootLayout>
