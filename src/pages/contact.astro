---
import RootLayout from "@/layouts/RootLayout.astro";
import { SITE_METADATA } from "@/consts";

// Contact methods. The array shape lets future channels (Bluesky, Mastodon)
// be appended without touching markup. Email stays as a placeholder token
// until the real value lands in a config edit.
const methods = [
  {
    label: "Email",
    value: "{{EMAIL}}",
    href: "mailto:{{EMAIL}}",
    external: false,
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/richard-tuharsky",
    href: SITE_METADATA.socials.linkedin,
    external: true,
  },
  {
    label: "X",
    value: "@ricarioth",
    href: SITE_METADATA.socials.twitter,
    external: true,
  },
  {
    label: "YouTube",
    value: "Richard Tuharsky",
    href: SITE_METADATA.socials.youtube,
    external: true,
  },
];
---

<RootLayout
  title={`Contact · ${SITE_METADATA.name}`}
  description="Ways to reach me. The fastest is a 30-minute call. Otherwise: email, LinkedIn, X, YouTube."
>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 xl:px-8 pt-16 pb-8">
    <p class="schema-annotation">§ · Contact</p>
    <h1 class="mt-6 font-display text-4xl sm:text-6xl leading-[1.05] tracking-tight text-foreground">
      Contact
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed">
      The fastest way to reach me is to book a 30-minute call. Otherwise, pick any of the channels below.
    </p>
  </section>

  <!-- Primary path: booking -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 xl:px-8 py-6" data-animate>
    <div class="border-t-2 border-accent bg-accent-soft/60 border-x border-b border-accent-ring/60 p-8">
      <p class="font-mono text-xs uppercase tracking-widest text-rule">Fastest</p>
      <h2 class="mt-3 font-display text-2xl sm:text-3xl leading-tight text-foreground">
        Book a 30-minute call
      </h2>
      <p class="mt-4 text-sm text-foreground/90 leading-relaxed max-w-xl">
        You leave the call knowing whether a health check is the right next step, or whether you need someone I'm not. No pitch, no slides.
      </p>
      <div class="mt-6">
        <a
          href="/#book"
          class="inline-flex items-center rounded-sm bg-cta px-5 py-3 text-sm font-medium text-cta-foreground hover:bg-cta-hover transition-colors"
        >
          Book a call
        </a>
      </div>
    </div>
  </section>

  <!-- Other channels -->
  <section class="mx-auto max-w-3xl px-4 sm:px-6 xl:px-8 py-10" data-animate>
    <p class="font-mono text-xs uppercase tracking-widest text-rule">Other channels</p>
    <dl class="mt-4 border-t border-b border-border/60 divide-y divide-border/60">
      {methods.map((m) => (
        <div class="py-4 grid gap-2 sm:grid-cols-[140px_1fr] items-baseline">
          <dt class="font-mono text-xs uppercase tracking-widest text-foreground">{m.label}</dt>
          <dd class="text-foreground text-base m-0">
            <a
              href={m.href}
              class="hover:text-accent transition-colors underline-offset-4 hover:underline"
              {...m.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
            >
              {m.value}
            </a>
          </dd>
        </div>
      ))}
    </dl>

    <p class="mt-6 text-sm text-muted-foreground">
      I reply within one working day.
    </p>
  </section>
</RootLayout>
