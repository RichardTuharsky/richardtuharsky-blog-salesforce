---
import RootLayout from "@/layouts/RootLayout.astro";
import { SITE_METADATA } from "@/consts";
import HubspotForm from "@/components/HubspotForm.astro";

// /contact is an escape hatch for visitors who won't book a call yet.
// Booking stays the primary conversion action site-wide. This page is NOT
// promoted in the main nav — reached only via the footer link and a single
// "Not ready to book?" line beneath the booking embed in §06.
---

<RootLayout
  title={`Contact · ${SITE_METADATA.name}`}
  description="Tell me what's going wrong with your HubSpot portal."
>
  <section class="mx-auto max-w-[560px] px-5 md:px-6 py-16 md:py-24" data-animate>
    <p class="schema-annotation">§ · Contact</p>
    <h1 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground">
      Tell me what's going wrong.
    </h1>
    <p class="mt-6 text-muted-foreground leading-relaxed">
      I reply within one working day. If it's something I don't do, I'll say so and point you somewhere better.
    </p>

    <!--
      HubSpot form embed. EU-hosted portal; region is set in consts.ts and
      passed to hbspt.forms.create. Reserved min-height 520px prevents CLS.
      Fallback email link renders automatically below the embed.
    -->
    <div class="mt-12">
      <HubspotForm variant="contact" minHeight="520px" />
    </div>

    <!-- Escape link. Tertiary text; underlines the link only on hover. -->
    <p class="mt-10 text-sm text-rule text-center">
      Prefer to talk?{" "}
      <a
        href="/#book"
        class="no-underline hover:underline underline-offset-4 hover:text-foreground transition-colors"
      >
        Book a 30-minute call. →
      </a>
    </p>
  </section>
</RootLayout>
