---
import { getCollection, getEntry } from "astro:content";
import RootLayout from "@/layouts/RootLayout.astro";
import { excludeDrafts, sortNotes } from "@/functions";
import { SITE_METADATA } from "@/consts";
import HubspotMeetings from "@/components/HubspotMeetings.astro";
import FormattedDate from "@/components/FormattedDate.astro";

const latestNotesRaw = sortNotes(await getCollection("notes", excludeDrafts)).slice(0, 3);
const latestNotes = await Promise.all(
  latestNotesRaw.map(async (note) => {
    const firstTagRef = note.data.tags[0];
    const tagEntry = firstTagRef ? await getEntry("tags", firstTagRef.id) : null;
    return { note, tagName: tagEntry?.data.name ?? null };
  }),
);

/*
 * Capability cards on §03. Each card's `noteSlug` points to a Note that
 * expands on how I think about that capability. If the note doesn't exist,
 * the "How I think about this →" link is hidden — never rendered as a
 * dead link or a greyed-out placeholder.
 */
const capabilityCards = [
  {
    title: "Data quality",
    description: "What's actually in the database, and what put it there.",
    question: "How many contacts in your CRM are the same person?",
    bullets: [
      "Duplicate count across contacts and companies, and the pattern creating them — form variations, import formatting, or an integration",
      "Property inventory: what exists, what's populated, what nobody has touched in a year",
      "Import history review, so you know which upload caused which mess",
    ],
    noteSlug: "data-quality",
  },
  {
    title: "Pipeline and lifecycle",
    description: "Whether your stages mean anything.",
    question: "Can two reps look at the same deal and agree what stage it's in?",
    bullets: [
      "Exit criteria for every stage, written down, usually for the first time",
      "Where lifecycle stages move automatically and where someone is doing it by hand",
      "Records sitting in a stage their own activity contradicts",
    ],
    noteSlug: "pipeline-lifecycle",
  },
  {
    title: "Automation and sync",
    description: "What's running, what overlaps, and who owns each field.",
    question: "If two systems both update the same field, which one wins?",
    bullets: [
      "Workflow inventory: what's active, what overlaps, what writes to the same property twice",
      "Integration sync direction and field ownership, mapped per field",
      "Where a loop can form between HubSpot and Salesforce, and which side to break it on",
    ],
    noteSlug: "automation-sync",
  },
];
const capabilityCardsResolved = await Promise.all(
  capabilityCards.map(async (card) => {
    const noteEntry = card.noteSlug
      ? await getEntry("notes", card.noteSlug).catch(() => undefined)
      : undefined;
    return { ...card, noteEntry };
  }),
);
---

<RootLayout title={SITE_METADATA.title} description={SITE_METADATA.description}>

  <!-- ============================================================ -->
  <!-- §01 HERO                                                     -->
  <!-- ============================================================ -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 xl:px-8 pt-20 pb-28 md:pt-28 md:pb-40 text-center" data-animate>
      <h1 class="font-display text-[2.5rem] sm:text-5xl lg:text-[3.75rem] leading-[1.05] tracking-[-0.025em] text-foreground">
        You don't need a new HubSpot. You need the one you have to work.
      </h1>
      <p class="mt-8 mx-auto max-w-2xl text-lg text-muted-foreground leading-relaxed">
        Most portals don't fail at setup. They decay after it. Duplicate records, lifecycle stages nobody maintains, workflows no one dares turn off, reports leadership has stopped believing. I find what's actually broken and fix it.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="#book" class="inline-flex items-center rounded-sm bg-cta px-5 py-3 text-sm font-medium text-cta-foreground hover:bg-cta-hover transition-colors">
          Book a call
        </a>
        <a href="/notes" class="inline-flex items-center rounded-sm border border-border px-5 py-3 text-sm font-medium text-foreground hover:border-foreground/40 transition-colors">
          Read the notes
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §02 CREDIBILITY: reassurance strip. No headline, no icons,   -->
  <!--     no cards, no borders between columns.                    -->
  <!-- ============================================================ -->
  <section class="border-t border-border/60 bg-tint-warm">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-8" data-animate>
      <p class="schema-annotation">§ 02 · Credibility</p>

      <!--
        Three equal-weight columns. Display-face headings above body.
        Third column holds the HubSpot Academy certification instead of
        a text body. Additional badges append in a flex row inside that
        column with a 16px gap without changing the layout.
      -->
      <div class="mt-6 grid gap-10 md:grid-cols-3">
        <div>
          <h3 class="font-display text-xl sm:text-2xl leading-tight text-foreground">Enterprise CRM background</h3>
          <p class="mt-3 text-sm text-foreground/90 leading-relaxed">
            CRM and marketing automation at a global technology company. Data integrity, integrations and operations at a scale where mistakes are expensive.
          </p>
        </div>
        <div>
          <h3 class="font-display text-xl sm:text-2xl leading-tight text-foreground">Platforms</h3>
          <p class="mt-3 text-sm text-foreground/90 leading-relaxed">
            HubSpot, Salesforce, Salesforce Marketing Cloud.
          </p>
        </div>
        <div>
          <h3 class="font-display text-xl sm:text-2xl leading-tight text-foreground">HubSpot Academy</h3>
          <ul class="mt-3 flex flex-wrap items-center gap-4">
            <li class="flex items-center gap-4">
              <a
                href="https://app-eu1.hubspot.com/academy/achievements/0vbb8j3x/en/1/richard-tuharsky/hubspot-sales-hub-software"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block rounded-sm"
              >
                <img
                  src="/assets/certs/hubspot-sales-hub-software.jpg"
                  alt="HubSpot Sales Hub Software certification"
                  width="88"
                  height="88"
                  loading="lazy"
                  decoding="async"
                  class="block max-w-[88px] h-auto"
                />
              </a>
              <p class="text-sm text-muted-foreground">
                Sales Hub Software. Verify on HubSpot Academy.
              </p>
            </li>
          </ul>
        </div>
      </div>

      <!--
        LOGO STRIP: commented out, ready to enable when there are real
        logos to show. Do not switch on before consent is secured for each.
      <div class="mt-10 pt-8 border-t border-border/60 opacity-60">
        <p class="schema-annotation mb-6">Worked with</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-8 items-center">
          {LOGOS.map(logo => <img src={logo.src} alt={logo.name} class="h-6 object-contain" />)}
        </div>
      </div>
      -->
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §03 WHAT I DO                                                -->
  <!--   Hierarchy: one primary offer, then three capability cards, -->
  <!--   then two plain secondary lines. Not a grid of equals — the -->
  <!--   visitor should leave knowing there is one thing to buy.    -->
  <!-- ============================================================ -->
  <section id="services" class="border-t border-border/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-24" data-animate>
      <p class="schema-annotation">§ 03 · What I do</p>

      <!--
        Primary offer block. Full width, visually dominant via 2px accent
        top border + accent-tinted background + generous padding. This
        block is the answer to "what do I actually buy from you".
      -->
      <article class="mt-8 border-t-2 border-accent bg-accent-soft/60 border-x border-b border-accent-ring/60">
        <div class="p-8 sm:p-10 text-center">
          <h2 class="font-display text-3xl sm:text-4xl leading-tight text-foreground">
            HubSpot Health Check
          </h2>
          <p class="mt-3 font-mono text-xs uppercase tracking-widest text-rule">
            Five working days. Fixed price, paid only after results.
          </p>
          <p class="mt-6 mx-auto max-w-2xl text-lg text-foreground/90 leading-relaxed">
            I go through your portal and tell you what's actually broken, what it's costing you, and what to fix first. Read only, I don't change anything in your account.
          </p>

          <div class="mt-10 pt-10 border-t border-accent-ring/60 grid gap-10 md:grid-cols-2 max-w-4xl mx-auto text-left">
            <div>
              <h3 class="font-mono text-xs uppercase tracking-widest text-rule">Who it's for</h3>
              <p class="mt-3 text-sm text-foreground/90 leading-relaxed">
                Companies twelve months or more into HubSpot who have stopped trusting what's in it. Reports that contradict the CRM, records that exist three times, automation nobody dares turn off.
              </p>
            </div>
            <div>
              <h3 class="font-mono text-xs uppercase tracking-widest text-rule">What you get</h3>
              <ul class="mt-3 space-y-2 text-sm text-foreground/90 leading-relaxed list-disc pl-5 marker:text-rule">
                <li>Findings document with severity ranking</li>
                <li>Prioritised fix list with effort estimates</li>
                <li>45-minute walkthrough call, recorded</li>
              </ul>
            </div>
          </div>
        </div>
      </article>

      <!--
        Three capability cards. Static, fully readable without interaction.
        No icons in tinted squares, no accordions. Each card ends with a
        conditional link to the corresponding note (rendered only when the
        note exists — never a dead or placeholder link).
      -->
      <div class="mt-16 grid gap-6 md:grid-cols-3">
        {capabilityCardsResolved.map((card) => (
          <article class="border border-border/60 bg-background p-6 flex flex-col">
            <h3 class="font-display text-xl text-foreground leading-tight">{card.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{card.description}</p>

            <blockquote class="mt-5 border-l-2 border-accent pl-4 italic text-foreground/90 text-sm leading-relaxed">
              "{card.question}"
            </blockquote>

            <p class="mt-6 font-mono text-xs uppercase tracking-widest text-rule">What this looks like</p>
            <ul class="mt-3 space-y-2 text-sm text-foreground/90 leading-relaxed list-disc pl-5 marker:text-rule">
              {card.bullets.map((b) => <li>{b}</li>)}
            </ul>

            {card.noteEntry && (
              <a
                href={`/notes/${card.noteEntry.id}`}
                class="mt-auto pt-6 text-sm text-accent hover:underline underline-offset-4"
              >
                How I think about this →
              </a>
            )}
          </article>
        ))}
      </div>

      <!-- Primary CTA for §03. Sits below the capability cards, centered. -->
      <div class="mt-12 text-center">
        <a href="#book" class="inline-flex items-center rounded-sm bg-cta px-5 py-3 text-sm font-medium text-cta-foreground hover:bg-cta-hover transition-colors">
          Book a call
        </a>
      </div>

      <!--
        Two secondary lines. Plain text, no cards, no links, no CTAs.
        They exist to show the work continues past the audit.
      -->
      <div class="mt-14 max-w-3xl space-y-4 text-sm text-muted-foreground leading-relaxed">
        <p>
          <strong class="text-foreground">Cleanup sprint</strong>, fixing what the health check finds. Scoped from the findings, priced per engagement.
        </p>
        <p>
          <strong class="text-foreground">Salesforce and HubSpot</strong>, sync repair, field ownership design, migration assessment. Priced per engagement.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §04 HOW I WORK: three phases as questions                    -->
  <!-- ============================================================ -->
  <section id="how-i-work" class="border-t border-border/60 bg-tint-sage">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-28" data-animate>
      <p class="schema-annotation">§ 04 · How I work</p>
      <h2 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground max-w-2xl">
        Three questions, in order. Skip one and the next is guesswork.
      </h2>

      <ol class="mt-14 grid gap-8 lg:grid-cols-3">
        <li class="schema-box" data-object="Phase 01 · Foundation">
          <p class="font-display text-xl text-foreground leading-snug pt-1">Can you trust your data?</p>
          <p class="mt-4 text-sm text-muted-foreground leading-relaxed">Deduplication, ownership rules, source-of-truth per object. Nothing else works if the answer is no.</p>
        </li>
        <li class="schema-box" data-object="Phase 02 · Process">
          <p class="font-display text-xl text-foreground leading-snug pt-1">Do your systems enforce your process?</p>
          <p class="mt-4 text-sm text-muted-foreground leading-relaxed">Pipeline stages that mean something, required fields at the right gates, workflow automations that don't fight the humans.</p>
        </li>
        <li class="schema-box" data-object="Phase 03 · Truth">
          <p class="font-display text-xl text-foreground leading-snug pt-1">Do your reports tell you the truth?</p>
          <p class="mt-4 text-sm text-muted-foreground leading-relaxed">Reports that survive the "prove it" question from a CFO. If the number moves when you refresh, the number is wrong.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §05 NOTES: latest three, real design weight                  -->
  <!-- ============================================================ -->
  <section class="border-t border-border/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-28" data-animate>
      <div class="flex items-end justify-between mb-14">
        <div>
          <p class="schema-annotation">§ 05 · Notes</p>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground">
            Working notes. Written to be defended in a call.
          </h2>
        </div>
        <a href="/notes" class="hidden sm:inline text-sm text-muted-foreground hover:text-foreground transition-colors">
          All notes →
        </a>
      </div>

      {latestNotes.length === 0 ? (
        <p class="text-muted-foreground">No notes yet.</p>
      ) : (
        <ul class="grid gap-px bg-border/60 border border-border/60 sm:grid-cols-3">
          {latestNotes.map(({ note, tagName }) => (
            <li class="bg-background">
              <a href={`/notes/${note.id}`} class="group block h-full p-8 transition-colors hover:bg-muted/40">
                <div class="flex items-center gap-3">
                  {tagName && <span class="tag-pill">{tagName}</span>}
                  <p class="text-xs font-mono uppercase tracking-widest text-rule">
                    <FormattedDate date={note.data.date} />
                  </p>
                </div>
                <h3 class="mt-4 font-display text-xl leading-snug text-foreground group-hover:text-accent transition-colors">
                  {note.data.title}
                </h3>
                <p class="mt-4 text-sm text-muted-foreground leading-relaxed line-clamp-3">
                  {note.data.summary}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )}

      <!--
        TESTIMONIALS stub, commented out. Enable when there are real
        quotes with named attribution. Anonymous quotes are worse than none.
      <div class="mt-24 pt-12 border-t border-border/60">
        <p class="schema-annotation mb-6">Voices</p>
        <div class="grid gap-10 md:grid-cols-2"></div>
      </div>
      -->
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §06 BOOK A CALL: single centered column stack.               -->
  <!--   Order: eyebrow, H1, 3-up label/body row, embed, fallback.  -->
  <!--   No side-by-side split. Embed sits below the copy.          -->
  <!--   Vertical rhythm: 48px (H1→row), 56px (row→embed),          -->
  <!--   24px (embed→fallback, handled inside HubspotMeetings).     -->
  <!-- ============================================================ -->
  <section id="book" class="border-t border-border/60 bg-tint-warm">
    <div class="mx-auto max-w-[680px] px-5 md:px-6 py-10 md:py-14" data-animate>
      <p class="schema-annotation">§ 06 · Book a call</p>
      <h2 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground">
        Pick a slot. 30 minutes.
      </h2>

      <!-- 3-up label/body row. Stacks to single column on mobile.
           Labels: 11px letter-spaced uppercase in --color-rule.
           Body: 15px in --color-foreground (primary), never accent. -->
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-widest text-rule">What I'll ask</p>
          <p class="mt-2 text-[15px] text-foreground leading-relaxed">
            Where the CRM lives now, what your team stops trusting first, the last few changes to your HubSpot, and who decided them.
          </p>
        </div>
        <div>
          <p class="font-mono text-[11px] uppercase tracking-widest text-rule">What you don't need to prepare</p>
          <p class="mt-2 text-[15px] text-foreground leading-relaxed">
            Nothing. If you can't answer a question, that's data too.
          </p>
        </div>
        <div>
          <p class="font-mono text-[11px] uppercase tracking-widest text-rule">What you'll know by the end</p>
          <p class="mt-2 text-[15px] text-foreground leading-relaxed">
            Whether a health check is the right next step, or whether you need someone I'm not.
          </p>
        </div>
      </div>

      <div class="mt-14">
        <HubspotMeetings />
      </div>

      <!-- Escape hatch to /contact. Only entry point to /contact from
           the homepage; keeps booking as the primary conversion action. -->
      <p class="mt-6 text-center text-sm text-muted-foreground">
        Not ready to book?{" "}
        <a
          href="/contact"
          class="no-underline hover:underline underline-offset-4 hover:text-foreground transition-colors"
        >
          Send me the details instead.
        </a>
      </p>
    </div>
  </section>

  <!-- FOOTER lives in RootLayout -->

</RootLayout>
