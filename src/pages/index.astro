---
import { getCollection, getEntry } from "astro:content";
import RootLayout from "@/layouts/RootLayout.astro";
import { excludeDrafts, sortNotes } from "@/functions";
import { SITE_METADATA, OFFERS } from "@/consts";
import SchemaObject from "@/components/SchemaObject.astro";
import HubspotMeetings from "@/components/HubspotMeetings.astro";
import FormattedDate from "@/components/FormattedDate.astro";

const latestNotesRaw = sortNotes(await getCollection("notes", excludeDrafts)).slice(0, 3);
const latestNotes = await Promise.all(
  latestNotesRaw.map(async (note) => {
    const firstTagRef = note.data.tags[0];
    const tagEntry = firstTagRef ? await getEntry("tags", firstTagRef.id) : null;
    return { note, tagName: tagEntry?.data.name ?? null };
  }),
);
---

<RootLayout title={SITE_METADATA.title} description={SITE_METADATA.description}>

  <!-- ============================================================ -->
  <!-- §01 HERO                                                     -->
  <!-- ============================================================ -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 xl:px-8 pt-20 pb-28 md:pt-28 md:pb-40 text-center" data-animate>
      <h1 class="font-display text-[2.5rem] sm:text-5xl lg:text-[3.75rem] leading-[1.05] tracking-[-0.025em] text-foreground">
        You don't need a new HubSpot. You need the one you have to work.
      </h1>
      <p class="mt-8 mx-auto max-w-2xl text-lg text-muted-foreground leading-relaxed">
        Most portals don't fail at setup — they decay after it. Duplicate records, lifecycle stages nobody maintains, workflows no one dares turn off, reports leadership has stopped believing. I find what's actually broken and fix it.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="#book" class="inline-flex items-center rounded-sm bg-cta px-5 py-3 text-sm font-medium text-cta-foreground hover:bg-cta-hover transition-colors">
          Book a call
        </a>
        <a href="/notes" class="inline-flex items-center rounded-sm border border-border px-5 py-3 text-sm font-medium text-foreground hover:border-foreground/40 transition-colors">
          Read the notes
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §02 CREDIBILITY: reassurance strip. No headline, no icons,   -->
  <!--     no cards, no borders between columns.                    -->
  <!-- ============================================================ -->
  <section class="border-t border-border/60 bg-tint-warm">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-8" data-animate>
      <p class="schema-annotation">§ 02 · Credibility</p>

      <!-- Three equal-weight text columns. Label above body. -->
      <div class="mt-5 grid gap-8 md:grid-cols-3">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-rule">Enterprise CRM background</p>
          <p class="mt-2 text-sm text-foreground/90 leading-relaxed">
            CRM and marketing automation at a global technology company. Data integrity, integrations and operations at a scale where mistakes are expensive.
          </p>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-rule">Platforms</p>
          <p class="mt-2 text-sm text-foreground/90 leading-relaxed">
            HubSpot, Salesforce, Salesforce Marketing Cloud. HubSpot is where I build for clients.
          </p>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-rule">Both sides of the sync</p>
          <p class="mt-2 text-sm text-foreground/90 leading-relaxed">
            I read Salesforce Flows and HubSpot workflows in the same sitting. Most consultants can only see one half of the problem.
          </p>
        </div>
      </div>

      <!--
        Certification row. Left-aligned, full width. Flex-row so additional
        badges append with a 16px gap without any layout change. No
        placeholder or greyed-out slots for future certifications.
      -->
      <div class="mt-10">
        <p class="font-mono text-xs uppercase tracking-widest text-rule">HubSpot Academy</p>
        <ul class="mt-3 flex flex-wrap items-center gap-4">
          <li class="flex items-center gap-4">
            <a
              href="https://app-eu1.hubspot.com/academy/achievements/0vbb8j3x/en/1/richard-tuharsky/hubspot-sales-hub-software"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-sm"
            >
              <img
                src="/assets/certs/hubspot-sales-hub-software.jpg"
                alt="HubSpot Sales Hub Software certification"
                width="88"
                height="88"
                loading="lazy"
                decoding="async"
                class="block max-w-[88px] h-auto"
              />
            </a>
            <p class="text-sm text-muted-foreground">
              Sales Hub Software. Verify on HubSpot Academy.
            </p>
          </li>
        </ul>
      </div>

      <!--
        LOGO STRIP: commented out, ready to enable when there are real
        logos to show. Do not switch on before consent is secured for each.
      <div class="mt-10 pt-8 border-t border-border/60 opacity-60">
        <p class="schema-annotation mb-6">Worked with</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-8 items-center">
          {LOGOS.map(logo => <img src={logo.src} alt={logo.name} class="h-6 object-contain" />)}
        </div>
      </div>
      -->
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §03 WHAT I DO: three scoped offers                           -->
  <!-- ============================================================ -->
  <section id="services" class="border-t border-border/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-24" data-animate>
      <p class="schema-annotation">§ 03 · What I do</p>
      <h2 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground max-w-xl">
        Three engagements. Everything else is a conversation, not a service.
      </h2>

      <div class="mt-14 grid gap-px bg-border/60 border border-border/60 sm:grid-cols-3">
        {OFFERS.map((offer) => (
          <div class="bg-background p-8 flex flex-col">
            <p class="schema-annotation">{offer.slug}</p>
            <h3 class="mt-3 font-display text-2xl text-foreground leading-tight">{offer.name}</h3>
            <p class="mt-4 text-sm text-muted-foreground">
              <span class="text-foreground font-medium">For:</span> {offer.who}
            </p>
            <p class="mt-3 text-sm text-muted-foreground">
              <span class="text-foreground font-medium">Delivered:</span> {offer.delivered}
            </p>
            <div class="mt-auto pt-8 flex items-baseline justify-between text-xs font-mono uppercase tracking-widest text-rule">
              <span>{offer.duration}</span>
              <span>{offer.price}</span>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-8 text-sm text-muted-foreground max-w-2xl">
        Not sure which fits? <a href="#book" class="underline underline-offset-4 hover:text-foreground">Book a call</a> and I will tell you honestly if none of them do.
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §05 SALESFORCE → HUBSPOT: the one topic with real authority  -->
  <!-- ============================================================ -->
  <section id="salesforce-to-hubspot" class="border-t border-border/60 bg-tint-cool">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-28" data-animate>
      <p class="schema-annotation">§ 04 · Salesforce → HubSpot</p>
      <p class="mt-8 max-w-2xl text-lg text-muted-foreground leading-relaxed">
        I've spent {`{{YEARS_SF}}`} years inside Salesforce orgs. Enough to know what breaks in a migration, what doesn't survive the schema flatten, and when the honest answer is <em class="not-italic text-foreground">stay on Salesforce</em>. This is the one topic on this site where deep authority is genuinely earned.
      </p>

      <!-- Signature: SF object morphing into a HubSpot object -->
      <div class="mt-14 grid gap-6 sm:grid-cols-[1fr_auto_1fr] items-center">
        <SchemaObject object="Account (SF)" fields={[
          { k: "Name", t: "text(255)" },
          { k: "RecordTypeId", t: "ref → RecordType" },
          { k: "OwnerId", t: "ref → User" },
          { k: "Custom_Field__c", t: "picklist" },
        ]} />
        <div class="flex justify-center">
          <span class="font-mono text-xs text-rule uppercase tracking-widest">migrates to →</span>
        </div>
        <SchemaObject object="Company (HubSpot)" fields={[
          { k: "name", t: "string" },
          { k: "lifecyclestage", t: "enum" },
          { k: "hubspot_owner_id", t: "ref → user" },
          { k: "custom_field", t: "dropdown" },
        ]} />
      </div>

      <div class="mt-14 grid gap-8 sm:grid-cols-3 text-sm">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-rule mb-3">What actually breaks</p>
          <p class="text-muted-foreground leading-relaxed">Record types, validation rules, and Apex-triggered automation. Migrations that treat those as "custom fields plus rules" underestimate the rebuild by 3 to 5 times.</p>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-rule mb-3">Migration assessment</p>
          <p class="text-muted-foreground leading-relaxed">A fixed-scope engagement. Your Salesforce org, mapped to a HubSpot data model, with a defensible cost and a defensible timeline before you sign anything.</p>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-rule mb-3">When to stay on Salesforce</p>
          <p class="text-muted-foreground leading-relaxed">Complex approval flows, deep territory management, or industry clouds you actually use. I will tell you if that's you, unpaid.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §05 HOW I WORK: three phases as questions                    -->
  <!-- ============================================================ -->
  <section id="how-i-work" class="border-t border-border/60 bg-tint-sage">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-28" data-animate>
      <p class="schema-annotation">§ 05 · How I work</p>
      <h2 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground max-w-2xl">
        Three questions, in order. Skip one and the next is guesswork.
      </h2>

      <ol class="mt-14 grid gap-8 lg:grid-cols-3">
        <li class="schema-box" data-object="Phase 01 · Foundation">
          <p class="font-display text-xl text-foreground leading-snug pt-1">Can you trust your data?</p>
          <p class="mt-4 text-sm text-muted-foreground leading-relaxed">Deduplication, ownership rules, source-of-truth per object. Nothing else works if the answer is no.</p>
        </li>
        <li class="schema-box" data-object="Phase 02 · Process">
          <p class="font-display text-xl text-foreground leading-snug pt-1">Do your systems enforce your process?</p>
          <p class="mt-4 text-sm text-muted-foreground leading-relaxed">Pipeline stages that mean something, required fields at the right gates, workflow automations that don't fight the humans.</p>
        </li>
        <li class="schema-box" data-object="Phase 03 · Truth">
          <p class="font-display text-xl text-foreground leading-snug pt-1">Do your reports tell you the truth?</p>
          <p class="mt-4 text-sm text-muted-foreground leading-relaxed">Reports that survive the "prove it" question from a CFO. If the number moves when you refresh, the number is wrong.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §06 NOTES: latest three, real design weight                  -->
  <!-- ============================================================ -->
  <section class="border-t border-border/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-28" data-animate>
      <div class="flex items-end justify-between mb-14">
        <div>
          <p class="schema-annotation">§ 06 · Notes</p>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground">
            Working notes. Written to be defended in a call.
          </h2>
        </div>
        <a href="/notes" class="hidden sm:inline text-sm text-muted-foreground hover:text-foreground transition-colors">
          All notes →
        </a>
      </div>

      {latestNotes.length === 0 ? (
        <p class="text-muted-foreground">No notes yet.</p>
      ) : (
        <ul class="grid gap-px bg-border/60 border border-border/60 sm:grid-cols-3">
          {latestNotes.map(({ note, tagName }) => (
            <li class="bg-background">
              <a href={`/notes/${note.id}`} class="group block h-full p-8 transition-colors hover:bg-muted/40">
                <div class="flex items-center gap-3">
                  {tagName && <span class="tag-pill">{tagName}</span>}
                  <p class="text-xs font-mono uppercase tracking-widest text-rule">
                    <FormattedDate date={note.data.date} />
                  </p>
                </div>
                <h3 class="mt-4 font-display text-xl leading-snug text-foreground group-hover:text-accent transition-colors">
                  {note.data.title}
                </h3>
                <p class="mt-4 text-sm text-muted-foreground leading-relaxed line-clamp-3">
                  {note.data.summary}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )}

      <!--
        TESTIMONIALS stub, commented out. Enable when there are real
        quotes with named attribution. Anonymous quotes are worse than none.
      <div class="mt-24 pt-12 border-t border-border/60">
        <p class="schema-annotation mb-6">Voices</p>
        <div class="grid gap-10 md:grid-cols-2"></div>
      </div>
      -->
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §07 WHAT HAPPENS ON THE CALL: de-risking                     -->
  <!-- ============================================================ -->
  <section class="border-t border-border/60 bg-tint-warm">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-28" data-animate>
      <p class="schema-annotation">§ 07 · What happens on the call</p>
      <div class="mt-6 grid gap-14 lg:grid-cols-[1fr_1.2fr]">
        <div></div>
        <div class="space-y-8">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-rule mb-2">What I'll ask</p>
            <p class="text-foreground/90 leading-relaxed">Where the CRM lives now, what your team stops trusting first, what the last three RevOps decisions were and why.</p>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-rule mb-2">What you don't need to prepare</p>
            <p class="text-foreground/90 leading-relaxed">Nothing. If you can't answer a question, that's data too.</p>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-rule mb-2">What you'll know by the end</p>
            <p class="text-foreground/90 leading-relaxed">Whether the problem is a build, a migration, a rescue, or something I don't take. Named. In under 30 minutes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- §08 BOOKING: HubSpot meetings embed                          -->
  <!-- ============================================================ -->
  <section id="book" class="border-t border-border/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-28" data-animate>
      <div class="max-w-2xl mb-12">
        <p class="schema-annotation">§ 08 · Book</p>
        <h2 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground">
          Pick a slot. 30 minutes.
        </h2>
      </div>
      <HubspotMeetings />
    </div>
  </section>

  <!-- §10 FOOTER lives in RootLayout -->

</RootLayout>
