---
import RootLayout from "@/layouts/RootLayout.astro";
import { SITE_METADATA } from "@/consts";
import {
  FOLLOW_ON_SERVICES,
  HEALTH_CHECK_SERVICE,
  SERVICE_CAPABILITIES,
} from "@/data/services";

---

<RootLayout
  title={`Services · ${SITE_METADATA.name}`}
  description="HubSpot Health Check, data quality, pipeline and lifecycle, automation and sync, cleanup, and Salesforce-HubSpot services."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 pt-16 pb-20">
    <p class="schema-annotation">§ · Services</p>
    <h1 class="mt-6 font-display text-4xl sm:text-6xl leading-[1.05] tracking-tight text-foreground max-w-4xl">
      Make the HubSpot you already have work properly.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed">
      I find the data, process, and automation problems that make teams stop trusting their CRM, then turn the findings into a practical fix plan.
    </p>
  </section>

  <section class="border-t border-border/60 bg-accent-soft/30">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-20" data-animate>
      <p class="schema-annotation">§ 01 · Start here</p>
      <div class="mt-8 border-t-2 border-accent bg-background border-x border-b border-accent-ring/60 p-8 sm:p-10">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.4fr]">
          <div>
            <h2 class="font-display text-3xl sm:text-4xl leading-tight text-foreground">
              {HEALTH_CHECK_SERVICE.name}
            </h2>
            <dl class="mt-8 space-y-4 text-sm">
              <div>
                <dt class="font-mono text-xs uppercase tracking-widest text-rule">Duration</dt>
                <dd class="mt-1 text-foreground">{HEALTH_CHECK_SERVICE.duration}</dd>
              </div>
              <div>
                <dt class="font-mono text-xs uppercase tracking-widest text-rule">Commercial terms</dt>
                <dd class="mt-1 text-foreground">{HEALTH_CHECK_SERVICE.commercial}</dd>
              </div>
            </dl>
          </div>

          <div>
            <p class="text-lg text-foreground/90 leading-relaxed">
              {HEALTH_CHECK_SERVICE.description}
            </p>
            <div class="mt-8 grid gap-8 md:grid-cols-2">
              <div>
                <h3 class="font-mono text-xs uppercase tracking-widest text-rule">Who it's for</h3>
                <p class="mt-3 text-sm text-foreground/90 leading-relaxed">
                  {HEALTH_CHECK_SERVICE.who}
                </p>
              </div>
              <div>
                <h3 class="font-mono text-xs uppercase tracking-widest text-rule">What you get</h3>
                <ul class="mt-3 space-y-2 text-sm text-foreground/90 leading-relaxed list-disc pl-5 marker:text-rule">
                  {HEALTH_CHECK_SERVICE.delivered.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
            <a href="/#book" class="mt-8 inline-flex items-center rounded-sm bg-cta px-5 py-3 text-sm font-medium text-cta-foreground hover:bg-cta-hover transition-colors">
              Book a call
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-24" data-animate>
      <p class="schema-annotation">§ 02 · What I examine</p>
      <h2 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground max-w-2xl">
        The three places where portal trust usually breaks.
      </h2>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {SERVICE_CAPABILITIES.map((service) => (
          <article class="border border-border/60 bg-background p-6 flex flex-col">
            <h3 class="font-display text-xl text-foreground leading-tight">{service.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{service.description}</p>
            <blockquote class="mt-5 border-l-2 border-accent pl-4 italic text-foreground/90 text-sm leading-relaxed">
              "{service.question}"
            </blockquote>
            <p class="mt-6 font-mono text-xs uppercase tracking-widest text-rule">What this includes</p>
            <ul class="mt-3 space-y-2 text-sm text-foreground/90 leading-relaxed list-disc pl-5 marker:text-rule">
              {service.bullets.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border/60 bg-tint-sage">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-24" data-animate>
      <p class="schema-annotation">§ 03 · After the health check</p>
      <h2 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground max-w-2xl">
        Findings can become a scoped implementation.
      </h2>
      <div class="mt-12 grid gap-px bg-border/60 border border-border/60 md:grid-cols-2">
        {FOLLOW_ON_SERVICES.map((service) => (
          <article class="bg-background p-8">
            <h3 class="font-display text-2xl text-foreground leading-tight">{service.name}</h3>
            <p class="mt-4 text-sm text-muted-foreground leading-relaxed">{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border/60">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 xl:px-8 py-24 text-center" data-animate>
      <p class="schema-annotation">§ 04 · Next step</p>
      <h2 class="mt-6 font-display text-3xl sm:text-4xl leading-tight text-foreground">
        Bring me the part of HubSpot your team no longer trusts.
      </h2>
      <p class="mt-5 text-muted-foreground leading-relaxed">
        In 30 minutes, we can work out whether a health check is the right starting point.
      </p>
      <a href="/#book" class="mt-8 inline-flex items-center rounded-sm bg-cta px-5 py-3 text-sm font-medium text-cta-foreground hover:bg-cta-hover transition-colors">
        Book a call
      </a>
    </div>
  </section>
</RootLayout>
