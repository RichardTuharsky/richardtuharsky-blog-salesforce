---
import RootLayout from "@/layouts/RootLayout.astro";
import { SITE_METADATA } from "@/consts";

const checklistAreas = [
  {
    title: "Data quality",
    description: "Duplicates, property sprawl, ownership gaps, and import history.",
  },
  {
    title: "Pipeline and lifecycle",
    description: "Stage definitions, exit criteria, lifecycle movement, and stuck records.",
  },
  {
    title: "Automation and sync",
    description: "Overlapping workflows, field ownership, sync direction, and integration loops.",
  },
  {
    title: "Reporting confidence",
    description: "The checks behind reports your sales team and leadership can trust.",
  },
] as const;
---

<RootLayout
  title={`Free HubSpot portal teardown checklist · ${SITE_METADATA.name}`}
  description="A practical checklist for reviewing HubSpot data quality, pipeline and lifecycle, automation, integrations, and reporting."
>
  <section class="border-b border-border/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-16 md:py-24">
      <div class="grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
        <div data-animate>
          <p class="schema-annotation">§ · Free portal teardown checklist</p>
          <h1 class="mt-6 max-w-3xl font-display text-4xl sm:text-6xl leading-[1.05] tracking-tight text-foreground">
            Find what is quietly breaking trust in your HubSpot portal.
          </h1>
          <p class="mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed">
            A practical checklist for reviewing the data, pipeline, automation, integrations, and reports inside the portal you already have.
          </p>

          <ul class="mt-10 grid gap-4 sm:grid-cols-2" aria-label="Checklist coverage">
            {checklistAreas.map((area, index) => (
              <li class="schema-box min-h-32" data-object={`Check ${String(index + 1).padStart(2, "0")}`}>
                <h2 class="pt-1 font-display text-xl leading-tight text-foreground">{area.title}</h2>
                <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{area.description}</p>
              </li>
            ))}
          </ul>
        </div>

        <aside class="border-t-2 border-accent border-x border-b border-accent-ring/60 bg-accent-soft/40 p-6 sm:p-8" data-animate>
          <p class="font-mono text-xs uppercase tracking-widest text-rule">Get the checklist</p>
          <h2 class="mt-4 font-display text-3xl leading-tight text-foreground">
            Send it to your inbox.
          </h2>
          <p class="mt-4 text-sm text-muted-foreground leading-relaxed">
            Enter your email and I will send you the checklist when delivery is connected.
          </p>

          <form id="teardown-checklist-form" class="mt-8" method="post" novalidate>
            <label for="checklist-email" class="block font-mono text-xs uppercase tracking-widest text-foreground">
              Email address
            </label>
            <input
              id="checklist-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              placeholder="you@company.com"
              class="mt-2 block w-full rounded-sm border-border bg-background px-4 py-3 text-foreground placeholder:text-rule focus:border-accent focus:ring-accent"
            />
            <p id="checklist-email-error" class="mt-2 text-sm text-red-700 dark:text-red-300" hidden>
              Enter a valid email address.
            </p>

            <button
              id="teardown-checklist-submit"
              type="submit"
              disabled
              class="mt-4 inline-flex w-full items-center justify-center rounded-sm bg-cta px-5 py-3 text-sm font-medium text-cta-foreground transition-colors hover:bg-cta-hover disabled:cursor-not-allowed disabled:opacity-60"
            >
              Get the free checklist
            </button>

            <p class="mt-4 text-xs text-muted-foreground leading-relaxed">
              No address is sent or stored yet. Email delivery will be connected in the next backend step.
            </p>
            <p
              id="checklist-form-status"
              class="mt-4 border-l-2 border-accent pl-3 text-sm text-foreground leading-relaxed"
              role="status"
              tabindex="-1"
              hidden
            >
              The form is ready, but email capture is not connected yet. Your address has not been submitted.
            </p>
          </form>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-tint-sage border-b border-border/60">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 xl:px-8 py-16" data-animate>
      <div class="grid gap-10 md:grid-cols-3">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-rule">Built for</p>
          <p class="mt-3 text-sm text-foreground leading-relaxed">
            Teams already using HubSpot who suspect the portal no longer reflects how they actually sell.
          </p>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-rule">Use it before</p>
          <p class="mt-3 text-sm text-foreground leading-relaxed">
            A cleanup project, a migration, a reporting rebuild, or a conversation about buying more software.
          </p>
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-rule">What it gives you</p>
          <p class="mt-3 text-sm text-foreground leading-relaxed">
            A structured way to separate visible symptoms from the configuration and ownership problems beneath them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    function bindTeardownChecklistForm() {
      const form = document.getElementById("teardown-checklist-form");
      const email = document.getElementById("checklist-email");
      const error = document.getElementById("checklist-email-error");
      const status = document.getElementById("checklist-form-status");
      const submit = document.getElementById("teardown-checklist-submit");

      if (
        !(form instanceof HTMLFormElement) ||
        !(email instanceof HTMLInputElement) ||
        !(error instanceof HTMLElement) ||
        !(status instanceof HTMLElement) ||
        !(submit instanceof HTMLButtonElement) ||
        form.dataset.bound === "true"
      ) return;

      form.dataset.bound = "true";
      submit.disabled = false;

      email.addEventListener("input", () => {
        error.hidden = true;
        email.removeAttribute("aria-invalid");
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();

        if (!email.validity.valid) {
          error.hidden = false;
          email.setAttribute("aria-invalid", "true");
          email.focus();
          return;
        }

        error.hidden = true;
        status.hidden = false;
        status.focus();
      });
    }

    document.addEventListener("astro:page-load", bindTeardownChecklistForm);
  </script>
</RootLayout>
