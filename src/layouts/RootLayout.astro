---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";

const t = useTranslations();

type Props = {
  title: string;
  description: string;
  titleTemplate?: string;
  robots?: string;
  canonical?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    authors: string[];
    tags: string[];
  };
};
---

<html lang={t("siteMetadata.language")} class="scroll-smooth">
  <BaseHead {...Astro.props} />
  <body class="bg-background text-foreground antialiased font-sans min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Entrance animation observer, respects prefers-reduced-motion (handled in CSS).
      const items = document.querySelectorAll<HTMLElement>("[data-animate]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              (e.target as HTMLElement).dataset.animateIn = "true";
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: "-40px" }
      );
      items.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
