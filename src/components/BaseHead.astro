---
import "@/styles/global.css";
import { SITE_METADATA } from "@/consts";
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import { getImage } from "astro:assets";
import HubspotTracking from "./HubspotTracking.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  robots?: string;
  titleTemplate?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    authors: string[];
    tags: string[];
  };
  canonical?: string;
}

const {
  title,
  description,
  robots = SITE_METADATA.robots,
  article,
  titleTemplate,
  canonical,
} = Astro.props;

// Placeholder-safe OG image. Falls back to /og-default.svg (see /public).
const ogUrl = new URL("/og-default.svg", Astro.site ?? SITE_METADATA.siteUrl).toString();
---

<head>
  <SEO
    title={title}
    {titleTemplate}
    titleDefault={SITE_METADATA.title}
    description={description}
    nofollow={robots.includes("nofollow")}
    noindex={robots.includes("noindex")}
    canonical={canonical ?? Astro.url.toString()}
    charset="utf-8"
    extend={{
      meta: [
        { name: "viewport", content: "width=device-width,initial-scale=1" },
      ],
      link: [
        { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
        { rel: "alternate", type: "application/rss+xml", href: "/rss.xml" },
      ],
    }}
    openGraph={{
      basic: {
        type: article ? "article" : "website",
        url: Astro.url.toString(),
        title,
        image: ogUrl,
      },
      optional: { locale: SITE_METADATA.locale, description },
      ...(article && {
        article: {
          publishedTime: article.publishedTime.toISOString(),
          modifiedTime: article.modifiedTime?.toISOString(),
          authors: article.authors,
          tags: article.tags,
        },
      }),
    }}
    twitter={{ card: "summary_large_image", title, description, image: ogUrl }}
  />
  <HubspotTracking />
  <ClientRouter />
  <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0e1015" media="(prefers-color-scheme: dark)" />
</head>
