---
import { SITE_METADATA } from "@/consts";

// Isolated HubSpot form embed using HubSpot's current "hs-form-frame"
// embed format. Three mount points on this site:
//   - "audit"        (high-intent), used on /services
//   - "lowFriction"  (low-friction), reserved for inline note contexts
//   - "contact"      (escape hatch), used on /contact
//
// EU-hosted portal. Region + portal ID + form ID all read from
// SITE_METADATA.hubspot. Do not hand-write the script src or the frame
// attributes — mirrors HubSpot's exact generated markup so the runtime
// initialises the form correctly.
//
// Placeholder-safe: if PORTAL_ID or the form ID is still {{PLACEHOLDER}},
// we render a visible stub instead of trying to embed a broken form.
//
// When the form IS live, a plain-text fallback is always rendered below.
// If a visitor declines cookies the embed may be blocked, and the page
// must still have a live path to reach me.

type Variant = "audit" | "lowFriction" | "contact";
interface Props {
  variant: Variant;
  label?: string;
  /** Reserve vertical space to prevent layout shift while the iframe loads. */
  minHeight?: string;
}
const { variant, label, minHeight } = Astro.props;

const { portalId, region, forms } = SITE_METADATA.hubspot;
const formId = forms[variant];
const canEmbed =
  portalId && !portalId.includes("{{") && formId && !formId.includes("{{");
const containerStyle = minHeight ? `min-height: ${minHeight};` : undefined;

// Region-aware script URL. Portal ID is baked into the script path
// itself — EU portals must use js-eu1.hsforms.net or the form silently
// fails to render with nothing in the console.
const scriptSrc =
  region === "eu1"
    ? `https://js-eu1.hsforms.net/forms/embed/${portalId}.js`
    : `https://js.hsforms.net/forms/embed/${portalId}.js`;
---

{canEmbed ? (
  <div class="hubspot-form">
    <script is:inline src={scriptSrc} defer></script>
    <div
      class="hs-form-frame"
      data-region={region}
      data-form-id={formId}
      data-portal-id={portalId}
      style={containerStyle}
    ></div>

    {/* Always-rendered fallback. Live path when the iframe is blocked. */}
    <p class="mt-4 text-sm text-muted-foreground">
      Form not loading?{" "}
      <a
        href="mailto:{{EMAIL}}"
        class="underline underline-offset-4 hover:text-foreground transition-colors"
      >
        Email me at {`{{EMAIL}}`}
      </a>.
    </p>
  </div>
) : (
  <div class="rounded-sm border border-dashed border-rule/60 bg-muted/50 p-6" style={containerStyle}>
    <div class="schema-annotation mb-2">HubSpot form · {variant}</div>
    <p class="text-sm text-muted-foreground">
      {label ?? "Placeholder, replace {{PORTAL_ID}} and the form ID in src/consts.ts to render this embed."}
    </p>
    <p class="mt-2 text-xs font-mono text-rule">
      Reminder: EU portals silently fail without region="eu1".
    </p>
  </div>
)}
